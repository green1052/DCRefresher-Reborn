{
    "name": "dcrefresher-reborn",
    "description": "디시인사이드 개선 확장 프로그램",
    "private": true,
    "version": "6.0.5",
    "type": "module",
    "scripts": {
        "dev": "wxt",
        "dev:firefox": "wxt -b firefox",
        "build": "wxt build",
        "build:firefox": "wxt build -b firefox",
        "zip": "wxt zip",
        "zip:firefox": "wxt zip -b firefox",
        "compile": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "e2e": "playwright test --project=chromium",
        "e2e:firefox": "playwright test --project=firefox",
        "postinstall": "wxt prepare"
    },
    "dependencies": {
        "@radix-ui/themes": "^3.3.0",
        "@webext-core/messaging": "^4.0.0",
        "dompurify": "^3.4.16",
