        "lucide-react": "^1.48.0",
        "radix-ui": "^1.6.7",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@types/bun": "^1.4.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@wxt-dev/auto-icons": "^1.1.2",
        "@wxt-dev/module-react": "^1.2.2",
        "jsdom": "^27.4.0",
        "mmdb-lib": "^3.0.3",
        "netmask": "^2.1.1",
        "oxc-transform-react": "^0.152.0",
        "postcss": "^8.5.28",
