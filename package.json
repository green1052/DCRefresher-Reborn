{
    "name": "dcrefresher-reborn",
    "description": "디시인사이드 개선 확장 프로그램",
    "private": true,
    "version": "6.3.0",
    "type": "module",
    "scripts": {
        "dev": "wxt",
        "dev:firefox": "wxt -b firefox",
        "build": "wxt build",
        "build:firefox": "wxt build -b firefox",
        "zip": "wxt zip",
        "zip:firefox": "wxt zip -b firefox",
        "compile": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "e2e": "wxt build && playwright test --project=chromium",
        "e2e:firefox": "wxt build -b firefox && playwright test --project=firefox",
        "e2e:live": "wxt build && playwright test --project=live",
        "postinstall": "wxt prepare"
    },
    "dependencies": {
        "@webext-core/messaging": "^4.0.2",
        "cn": "^0.5.2",
        "dompurify": "^3.5.0",
        "ky": "^2.2.0",
        "lucide-preact": "^1.82.0",
        "p-limit": "^7.3.3",
        "preact": "^11.2.0",
        "quick-lru": "^8.0.0",
        "zustand": "^5.1.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.65.1",
        "@tailwindcss/vite": "^4.3.5",
        "@types/bun": "^1.4.5",
        "@wxt-dev/auto-icons": "^2.0.0",
        "daisyui": "^5.8.3",
        "jsdom": "^31.0.1",
        "mmdb-lib": "^3.0.5",
        "netmask": "^2.1.2",
        "tailwindcss": "^4.3.5",
        "tw-animate-css": "^1.4.0",
        "typescript": "^7.0.2",
        "vite": "^8.4.0",
        "vitest": "^5.1.2",
        "web-ext": "^10.8.0",
        "wxt": "^0.21.5"
    }
}
