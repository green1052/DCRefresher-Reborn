{
    "displayName": "DCRefresher Reborn",
    "name": "dcrefresher-reborn",
    "version": "4.0.0",
    "author": "green1052",
    "homepage": "https://github.com/green1052/DCRefresher-Reborn",
    "description": "디시인사이드 개선 확장 프로그램",
    "devDependencies": {
        "@eslint/js": "^9.33.0",
        "@parcel/resolver-glob": "2.9.3",
        "@plasmohq/parcel-config": "^0.42.0",
        "@types/chrome": "^0.1.3",
        "@types/js-cookie": "^3.0.6",
        "cash-dom": "^8.1.5",
        "eslint": "^9.33.0",
        "eslint-config-prettier": "^10.1.7",
        "eslint-plugin-prettier": "^5.5.4",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "eslint-plugin-vue": "^10.4.0",
        "globals": "^16.3.0",
        "js-cookie": "^3.0.5",
        "ky": "^1.8.2",
        "prettier": "^3.6.2",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.39.0"
    },
    "scripts": {
        "dev": "plasmo dev",
        "build": "plasmo build --hoist --zip --target=chrome-mv3 && plasmo build --hoist --zip --target=firefox-mv2"
    },
    "packageManager": "pnpm@10.14.0",
    "dependencies": {
        "@plasmohq/messaging": "^0.7.2",
        "@plasmohq/storage": "^1.15.0",
        "plasmo": "^0.90.5",
        "sass": "^1.90.0",
        "vue": "^3.5.18"
    },
    "manifest": {
        "host_permissions": [
            "https://*.dcinside.com/*"
        ],
        "permissions": [
            "activeTab",
            "contextMenus",
            "storage",
            "scripting",
            "unlimitedStorage"
        ],
        "web_accessible_resources": [
            {
                "resources": [
                    "assets/*.webp"
                ],
                "matches": [
                    "<all_urls>"
                ]
            }
        ],
        "commands": {
            "refreshLists": {
                "suggested_key": {
                    "default": "Alt+R"
                },
                "description": "글 목록 새로고침: 새로고침"
            },
            "refreshPause": {
                "suggested_key": {
                    "default": "Alt+S"
                },
                "description": "글 목록 새로고침: 일시 비활성화"
            },
            "stealthPause": {
                "suggested_key": {
                    "default": "Alt+P"
                },
                "description": "스텔스 모드: 일시 비활성화"
            }
        }
    }
}
