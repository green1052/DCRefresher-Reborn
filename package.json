{
    "name": "dcrefresher-reborn",
    "description": "디시인사이드 개선 확장 프로그램",
    "private": true,
    "version": "6.1.1",
    "type": "module",
    "scripts": {
        "dev": "wxt",
        "dev:firefox": "wxt -b firefox",
        "build": "wxt build",
        "build:firefox": "wxt build -b firefox",
        "zip": "wxt zip",
        "zip:firefox": "wxt zip -b firefox",
        "compile": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "e2e": "wxt build && playwright test --project=chromium",
        "e2e:firefox": "wxt build -b firefox && playwright test --project=firefox",
        "e2e:live": "wxt build && playwright test --project=live",
        "postinstall": "wxt prepare"
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@webext-core/messaging": "^4.0.0",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.4.0",
        "dompurify": "^3.4.16",
        "ky": "^2.2.0",
        "lucide-react": "^1.54.0",
        "p-limit": "^7.3.3",
        "preact": "^11.0.1",
        "quick-lru": "^7.3.0",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.0",
        "@preact/preset-vite": "^2.10.6",
        "@tailwindcss/vite": "^4.3.3",
        "@types/bun": "^1.4.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@wxt-dev/auto-icons": "^1.1.2",
        "jsdom": "^30.1.2",
        "mmdb-lib": "^3.0.3",
        "netmask": "^2.1.1",
        "shadcn": "^4.21.4",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "typescript": "^7.0.2",
        "vite": "^8.3.4",
        "vitest": "^5.0.3",
        "web-ext": "^10.7.0",
        "wxt": "^0.21.4"
    }
}
