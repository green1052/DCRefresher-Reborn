{
    "extends": "./.wxt/tsconfig.json",
    "compilerOptions": {
        "jsx": "react-jsx",
        "jsxImportSource": "preact",
        // .wxt/tsconfig.json의 paths와 같다. DB 워크플로(db.yml)가 .wxt 없이(--ignore-scripts) 이 경로로 @/를 푼다. 지우면 예약 DB 빌드만 깨진다.
        "paths": {
            "@/*": [
                "./*"
            ]
        },
        "noUnusedLocals": true,
        "noUnusedParameters": true
    }
}